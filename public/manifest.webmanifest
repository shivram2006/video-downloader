{
  "name": "OmniVid - Universal Video Downloader",
  "short_name": "OmniVid",
  "description": "Download public videos in custom resolutions or extract audio into MP3 and M4A formats.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#09090b",
  "theme_color": "#4f46e5",
  "categories": ["utilities", "multimedia", "productivity"],
  "icons": [
    {
      "src": "/favicon.png",
      "sizes": "64x64",
      "type": "image/png"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Download Video",
      "short_name": "Download",
      "url": "/?tab=video",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Extract Audio",
      "short_name": "Audio",
      "url": "/?tab=audio",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
